PROJECT_NAME="Sistema Escolar - Control de Asistencia y Carnetización"
ENVIRONMENT="development"
DEBUG=true

# Database PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=escuela_db

# DATABASE_URL con driver asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/escuela_db

# Security & JWT
SECRET_KEY=supersecretkey_change_me_in_production_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
